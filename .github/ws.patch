+/// A workspace's row in 全部对话: icon, title, member count and a chevron
+/// that turns as the group opens. Tap: open or close.
+class DrawerWorkspaceHeader extends StatelessWidget {
+  const DrawerWorkspaceHeader({
+    super.key,
+    required this.title,
+    required this.count,
+    required this.open,
+    required this.onTap,
+  });
+
+  final String title;
+  final int count;
+  final bool open;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final colors = DshColors.of(context);
+    return Semantics(
+      button: true,
+      expanded: open,
+      label: title,
+      excludeSemantics: true,
+      child: Material(
+        type: MaterialType.transparency,
+        child: InkWell(
+          onTap: onTap,
+          customBorder: Squircle.border(AppShape.md),
+          child: SizedBox(
+            height: SessionTile.height,
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 10),
+              child: Row(
+                children: [
+                  Icon(AppIcons.workspaceGroup, size: 20, color: colors.textTertiary),
+                  const SizedBox(width: 10),
+                  Expanded(
+                    child: Text(
+                      title,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: theme.textTheme.bodyLarge?.copyWith(
+                        fontSize: 15,
+                        height: 1.4,
+                        color: theme.colorScheme.onSurface,
+                        fontWeight: FontWeight.w500,
+                      ),
+                    ),
+                  ),
+                  const SizedBox(width: 8),
+                  Text(
+                    '$count',
+                    style: AppType.tabular(theme.textTheme.bodySmall!.copyWith(color: colors.textTertiary)),
+                  ),
+                  const SizedBox(width: 4),
+                  AnimatedRotation(
+                    turns: open ? 0 : -0.25,
+                    duration: AppMotion.of(context, AppMotion.collapse),
+                    curve: AppMotion.collapseCurve,
+                    child: Icon(AppIcons.expand, size: 18, color: colors.textTertiary),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
